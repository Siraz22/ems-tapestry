<html xmlns:t="http://tapestry.apache.org/schema/tapestry_5_4.xsd">
<body style="margin: 10px;">
<h2>Login Form</h2>
<form t:type="form" t:id="loginForm" class="form-horizontal">

    <div t:type="Errors" t:banner="message:validation-banner" t:class="literal:alert alert-danger"></div>
    <div id="loginMessage">${loginMessage}</div>

    <div class="form-group">
        <label t:type="label" for="username"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="username" t:validate="required" placeholder=" " />
        </div>
    </div>

    <div>
        <label t:type="label" for="password"/>
        <input type="password" name="password" t:type="passwordfield" t:id="password" id="password" />
    </div>

    <div>
        <input type="submit" id="submit" class="btn btn-primary"/>
    </div>

</form>
</body>
</html>