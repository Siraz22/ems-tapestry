<html xmlns:t="http://tapestry.apache.org/schema/tapestry_5_4.xsd">
<body style="margin: 10px;">
<h3>Edit Employee</h3>
<t:form t:id="form" class="form-horizontal">
    <t:if test="employee">
        <div class="form-group">
            <t:label for="name" class="col-sm-2" />
            <div class="col-sm-4">
                <t:textfield t:id="name" t:value="employee.name" class="form-control" placeholder="Name"/>
            </div>
        </div>

        <div class="form-group">
            <t:label for="age" class="col-sm-2" />
            <div class="col-sm-4">
                <t:textfield t:id="age" t:value="employee.age" class="form-control" placeholder="Age"/>
            </div>
        </div>

        <h4>Address</h4>
        <div class="form-group">
            <t:label for="street1" class="col-sm-2"/>
            <div class="col-sm-4">
                <t:textfield t:id="street1" t:value="street1" class="form-control" placeholder="Street 1"/>
            </div>
        </div>

        <div class="form-group">
            <t:label for="street2" class="col-sm-2"/>
            <div class="col-sm-4">
                <t:textfield t:id="street2" t:value="street2" class="form-control" placeholder="Street 2"/>
            </div>
        </div>

        <div class="form-group">
            <t:label for="zip" class="col-sm-2"/>
            <div class="col-sm-4">
                <t:textfield t:id="zip" t:value="zip" class="form-control" placeholder="Zip"/>
            </div>
        </div>

        <div class="form-group">
            <t:label for="country" class="col-sm-2"/>
            <div class="col-sm-4">
                <t:textfield t:id="country" t:value="country" class="form-control" placeholder="Country"/>
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-4">
                <t:submit value="Update Employee"/>
            </div>
        </div>
    </t:if>
</t:form>

<t:pagelink page="employee/ListEmployees">Go back to Employee List</t:pagelink><br/>
</body>
</html>
