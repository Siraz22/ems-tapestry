<html xmlns:t="http://tapestry.apache.org/schema/tapestry_5_4.xsd">
<body style="margin: 10px;">
<h3>Add Employee</h3>
<form t:type="form" t:id="form" class="form-horizontal">
    <div t:type="Errors" t:banner="message:validation-banner" class="alert alert-danger"></div>

    <div class="form-group">
        <label t:type="label" for="name"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="name" t:validate="required" placeholder="Name"/>
        </div>
    </div>

    <div class="form-group">
        <label t:type="label" for="username"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="username" t:validate="required" placeholder="Username"/>
        </div>
    </div>

    <div class="form-group">
        <label t:type="label" for="password"/>
        <div class="col-sm-4">
            <input type="password" t:type="passwordfield" t:id="password" t:validate="required" placeholder="Password"/>
        </div>
    </div>

    <div class="form-group">
        <label t:type="label" for="age"/>
        <div class="col-sm-4">
            <input type="number" t:type="textfield" t:id="age" t:validate="required" placeholder="Age"/>
        </div>
    </div>

    <h4>Address</h4>
    <div class="form-group">
        <label t:type="label" for="street1"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="street1" t:validate="required" placeholder="Street 1"/>
        </div>
    </div>

    <div class="form-group">
        <label t:type="label" for="street2"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="street2" placeholder="Street 2"/>
        </div>
    </div>

    <div class="form-group">
        <label t:type="label" for="zip"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="zip" t:validate="required" placeholder="Zip Code"/>
        </div>
    </div>

    <div class="form-group">
        <label t:type="label" for="country"/>
        <div class="col-sm-4">
            <input type="text" t:type="textfield" t:id="country" t:validate="required" placeholder="Country"/>
        </div>
    </div>

    <div>
        <input type="submit" class="btn btn-primary" value="Create Employee"/>
    </div>
</form>

<t:pagelink page="employee/ListEmployees">Go back to Employee List</t:pagelink>
</body>
</html>
